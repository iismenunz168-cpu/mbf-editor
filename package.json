{
  "name": "golden-finance-loan-letter",
  "private": true,
  "version": "1.0.15",
  "repository": {
    "type": "git",
    "url": "https://github.com/iismenunz168-cpu/mbf-editor.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1 --port 5189 --strictPort\" \"wait-on http://127.0.0.1:5189 && electron . --dev-server-url=http://127.0.0.1:5189\"",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:portable": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "firebase": "^13.2.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.1",
    "electron": "33.4.11",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.1.10",
    "vite": "^6.3.5",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.creditonsolutions.loanletter",
    "productName": "MBF EDITOR",
    "publish": [
      {
        "provider": "github",
        "owner": "iismenunz168-cpu",
        "repo": "mbf-editor",
        "channel": "latest",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/crediton-icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "MBF-EDITOR-Setup-${version}.${ext}",
      "installerIcon": "build/crediton-icon.ico",
      "uninstallerIcon": "build/crediton-icon.ico"
    },
    "portable": {
      "artifactName": "MBF-EDITOR-Portable.exe"
    }
  }
}
